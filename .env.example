# Copy to .env and fill in. Never commit .env.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the Fastify API (ADR 0001). Defaults to http://localhost:3001.
EXPO_PUBLIC_API_URL=http://localhost:3001
# 1 = answer flight lookups from src/lib/mock/candidates.ts instead of the API.
EXPO_PUBLIC_MOCK_API=0

# API / worker (server-side only)
# SUPABASE_URL and SUPABASE_ANON_KEY fall back to the EXPO_PUBLIC_* values above
# when unset, so only the service-role key below is strictly additional.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# REQUIRED for the API. Bypasses RLS; the only key that may write `flights`,
# and only through ingestFlight (ADR 0001, PROJECT_OVERVIEW §12.7).
# Supabase dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy HS256 signing secret. Unused while the project's JWKS
# publishes an asymmetric key, which it does; see apps/api/src/auth.ts.
SUPABASE_JWT_SECRET=
# REQUIRED for the worker (services/poller). The Supabase SESSION POOLER string
# for the restricted flightbuddy_worker role, not the direct host (IPv6-only, so
# Render cannot reach it) and not the transaction pooler (pg-boss needs
# session-level features). Keep ?sslmode=require on it.
DATABASE_URL=
RAPIDAPI_KEY=
AERODATABOX_HOST=aerodatabox.p.rapidapi.com

# Worker (services/poller; all optional, defaults shown)
# Phase 2 wave 3: the public webhook receiver URL including its secret path
# segment. Wave 4: the owner's profile id, for low-credit and failover alerts.
WEBHOOK_URL=
OPERATOR_USER_ID=
# Wave 5 (recommended): Expo access token for push sends. With Expo's "enhanced
# push security" on, sends without it are refused. A secret; never logged.
EXPO_ACCESS_TOKEN=
POLL_INTERVAL_MS=30000
POLL_BATCH_SIZE=25
# Provider requests per second for the worker's token bucket. The plan allows 2;
# the worker takes 1 and leaves the other for the API's interactive lookups.
PROVIDER_RPS=1

# API server (all optional; defaults shown)
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated origins, or * . The mobile client is not a browser.
CORS_ORIGIN=*
# Phase 2 wave 3: the secret path segment of the AeroDataBox webhook receiver,
# POST /webhooks/aerodatabox/<token> (ADR 0003). 32-100 URL-safe characters
# (A-Z a-z 0-9 _ -). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Empty = the receiver route is not registered at all. The worker's WEBHOOK_URL
# carries the same value as its last path segment.
WEBHOOK_TOKEN=

# Worker: backup poll for a subscribed flight inside the alert window, in ms
# (ADR 0004; 0 disables it and restores §7.6's "no polling at all").
WEBHOOK_BACKUP_POLL_MS=7200000
# Worker: the API's health URL, pinged so a Render free web service does not
# sleep. Not a secret (/healthz, no auth). Unset = no ping.
KEEPALIVE_URL=
KEEPALIVE_INTERVAL_MS=600000
