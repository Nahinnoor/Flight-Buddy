# Copy to .env and fill in. Never commit .env.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Base URL of the Fastify API (ADR 0001). Defaults to http://localhost:3001.
EXPO_PUBLIC_API_URL=http://localhost:3001
# 1 = answer flight lookups from src/lib/mock/candidates.ts instead of the API.
EXPO_PUBLIC_MOCK_API=0

# API / worker (server-side only)
# SUPABASE_URL and SUPABASE_ANON_KEY fall back to the EXPO_PUBLIC_* values above
# when unset, so only the service-role key below is strictly additional.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# REQUIRED for the API. Bypasses RLS; the only key that may write `flights`,
# and only through ingestFlight (ADR 0001, PROJECT_OVERVIEW §12.7).
# Supabase dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Optional legacy HS256 signing secret. Unused while the project's JWKS
# publishes an asymmetric key, which it does; see apps/api/src/auth.ts.
SUPABASE_JWT_SECRET=
DATABASE_URL=
RAPIDAPI_KEY=
AERODATABOX_HOST=aerodatabox.p.rapidapi.com

# API server (all optional; defaults shown)
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated origins, or * . The mobile client is not a browser.
CORS_ORIGIN=*
